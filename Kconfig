# mcp251xfd - Microchip MCP251XFD SPI CAN controllers
# (standalone copy of the drivers/net/can/spi/mcp251xfd Kconfig entry)

config CAN_MCP251XFD
	tristate "Microchip MCP251XFD SPI CAN controllers"
	depends on CAN && SPI
	select REGMAP
	help
	  Driver for the Microchip MCP251XFD SPI FD-CAN controller family
	  (MCP2515FD, MCP2516FD, MCP2517FD, MCP2518FD, ...).

config CAN_MCP251XFD_SANITY
	depends on CAN_MCP251XFD
	bool "Additional Sanity Checks"
	help
	  This option enables additional sanity checks in the driver,
	  that compares various internal counters with the in chip
	  variants. This comes with a runtime overhead.
	  Disable if unsure.
